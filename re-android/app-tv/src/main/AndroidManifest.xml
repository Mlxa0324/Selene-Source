<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 允许 TV 壳访问本地后台接口。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 声明当前应用兼容 Android TV 设备。 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- TV 设备不应强依赖触摸屏，否则会被商店和 lint 判定为不兼容。 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".SeleneTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/tv_icon"
        android:label="Selene TV"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="${seleneTvUsesCleartextTraffic}">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <!-- 提供常规启动入口。 -->
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
